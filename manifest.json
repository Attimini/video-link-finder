{
  "manifest_version": 3,
  "name": "Video Link Finder",
  "version": "1.0.0",
  "description": "Finds the real player (iframe) and stream (m3u8/mpd/mp4) links behind embedded videos.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "panel.html",
    "default_title": "Video Link Finder",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+L" } }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.html", "panel.css", "panel.js"], "matches": ["<all_urls>"] }
  ]
}
